// kate6bot のSQLiteスキーマ(Turso / libSQL)
// https://dbdiagram.io に貼ると可視化できます

Table members {
  discord_user_id text [pk, note: "Discordのユーザーid"]
  tier text [note: "段位: 1〜6, 勇士, 最高峰。未設定ならNULL"]
  updated_at text [not null, note: "最終更新日時(ISO8601)"]
}

Table bios {
  discord_user_id text [pk, note: "自己紹介の持ち主"]
  content text [not null, note: "自己紹介の本文(1人1件。/自己紹介 のフォームで上書きされる)"]
  updated_at text [not null, note: "最終更新日時(ISO8601)"]
}
