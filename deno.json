{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --env-file src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --env-file src/main.ts",
    "register-commands": "deno run --allow-net --allow-env --env-file scripts/register-commands.ts",
    "sync-env": "gh secret set -f .env"
  },
  "imports": {
    "@discordeno/bot": "npm:@discordeno/bot@21.0.0",
    "@libsql/client": "npm:@libsql/client@0.15.15"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "docs/slides.md"
    ]
  }
}
